# ==============================================================================
# MarketLens AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with local values.
# NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# Application Environment (development, staging, production)
MARKETLENS_ENV=development

# Logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
MARKETLENS_LOG_LEVEL=INFO

# Global reproducible random seed
MARKETLENS_RANDOM_SEED=42

# Optional overrides for local directories (defaults to project relative paths)
# DATA_DIR=./data
# ARTIFACTS_DIR=./artifacts

# Database Connection (PostgreSQL or SQLite fallback for development)
# Example: postgresql://user:password@localhost:5432/marketlens
DATABASE_URL=sqlite:///./artifacts/marketlens.db

# Large Language Model Provider API Keys (Used by Market Intelligence Agents)
# In Phase 0, LLM agents are mocked and no API keys are required.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional MLOps & Experiment Tracking
# Example: http://localhost:5000 or file:./mlruns
MLFLOW_TRACKING_URI=./mlruns

# Optional Kaggle API credentials (for automated dataset downloads in Phase 1)
# KAGGLE_USERNAME=
# KAGGLE_KEY=
