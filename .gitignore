# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment and secrets
.env
.env.*
!.env.example

# Testing and coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# MLOps and experiment tracking
mlruns/
mlartifacts/
.mlflow/

# Data folders - ignore raw/derived data but keep structure
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
data/manifests/*
!data/manifests/.gitkeep
!data/manifests/*.json
!data/manifests/profiles/
!data/manifests/profiles/*.json

# Artifacts - ignore models and generated reports but keep folder
artifacts/*
!artifacts/.gitkeep

# Logs
*.log
logs/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Frontend (Node / Vite)
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
